{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "amarcode",
  "version": "0.1.0",
  "identifier": "com.amarcode.desktop",
  "build": {
    "beforeDevCommand": "bun run --cwd .. dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd .. build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "amarcode",
        "width": 1320,
        "height": 860,
        "resizable": true,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
