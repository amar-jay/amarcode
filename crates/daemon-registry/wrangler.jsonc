{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amarcode-daemon-distribution",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "secrets": {
    "required": ["GITHUB_TOKEN"],
  },

  "r2_buckets": [
    {
      "binding": "DAEMON_ARTIFACTS",
      "bucket_name": "amarcode-daemons",
    },
  ],
  "routes": [
    {
      "pattern": "updates.amarcode.amarjay.com",
      "zone_name": "amarjay.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
  ],
}
