---
import Landing from '../layouts/Landing.astro';
import Navigation from '../components/navigation';
import CloudHero from '../components/cloud-hero';
import AppPreview from '../components/app-preview';
import HeadlessDaemon from '../components/headless-daemon';
import AgentLogos from '../components/agent-logos';
import { Features, Questions, Closing } from '../components/sections';
---
<Landing>
  <a href="#main" class="fixed -top-[100px] left-5 z-[100] bg-paper p-3 text-ink focus:top-2.5">Skip to content</a>
  <div class="[--navigation-height:88px] max-[601px]:[--navigation-height:118px] motion-reduce:[&_*]:animate-none motion-reduce:[&_*]:transition-none mx-auto max-w-[1392px] border-x border-rule max-[901px]:mx-5 max-[601px]:mx-3 [&_a]:touch-manipulation [&_a]:underline-offset-[5px] [&_a]:[-webkit-tap-highlight-color:transparent] [&_button]:touch-manipulation [&_button]:rounded-none [&_button]:[-webkit-tap-highlight-color:transparent] [&_[data-slot]]:rounded-none [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-[#80602a] [&_a:focus-visible]:outline-offset-[5px] [&_button:focus-visible]:outline-2 [&_button:focus-visible]:outline-[#80602a] [&_button:focus-visible]:outline-offset-[5px] [&_[role=tab]:focus-visible]:outline-2 [&_[role=tab]:focus-visible]:outline-[#80602a] [&_[role=tab]:focus-visible]:outline-offset-[5px]">
    <Navigation />
    <main id="main">
      <CloudHero client:load />
      <AppPreview client:visible />
      <Features />
      <AgentLogos client:visible />
      <HeadlessDaemon />
      <Questions client:visible />
      <Closing client:visible />
    </main>
  </div>
</Landing>
