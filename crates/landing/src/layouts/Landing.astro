---
import { site, socialImage, socialImageAlt } from '../../site.config.mjs';
import '../index.css';
const title = 'Amarcode — Your agents. One continuous conversation.';
const description = 'Bring your coding agents into one workspace. Keep the conversation, even when you change agents.';
---
<!doctype html>
<html lang="en" class="scroll-smooth scroll-pt-5 font-sans scheme-light motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="application-name" content="Amarcode" />
    <link rel="canonical" href={new URL('/', site).href} />
    <meta name="theme-color" content="#fafaf6" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Amarcode" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL('/', site).href} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
  </head>
  <body data-pagefind-ignore="all" class="m-0 bg-background text-[20px] text-foreground antialiased">
    <slot />
  </body>
</html>
