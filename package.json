{
  "name": "amarcode",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/application dev",
    "build": "bun run --cwd apps/application build",
    "test": "bun run --cwd apps/application test",
    "tauri": "bun run --cwd apps/application tauri",
    "tauri:dev": "bun run --cwd apps/application tauri:dev",
    "daemon": "cargo run -p amarcode-daemon --bin amarcode-daemon --",
    "daemon:cli": "cargo run -p amarcode-daemon --bin daemon-test-cli --",
    "daemon:check": "cargo test -p amarcode-daemon"
  }
}
