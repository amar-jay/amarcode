{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACP Workbench",
  "version": "0.1.0",
  "identifier": "com.acpworkbench.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ACP Workbench", "width": 1320, "height": 860, "minWidth": 980, "minHeight": 640, "decorations": false }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
